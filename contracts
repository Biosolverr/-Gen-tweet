    def get_profile_breakdown(self) -> str:
        counts = {}
        for p in self.profile_used:
            s = str(p)
            if s in counts:
                counts[s] = counts[s] + 1
            else:
                counts[s] = 1
        return json.dumps(counts)

    @gl.public.view
    def get_hard_rule_breakdown(self) -> str:
        counts = {}
        for r in self.hard_rule_triggered:
            s = str(r)
            if s == "":
                s = "none"
            if s in counts:
                counts[s] = counts[s] + 1
            else:
                counts[s] = 1
        return json.dumps(counts)

