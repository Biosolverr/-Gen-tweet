        # Threshold 40, мягкие правила, только spam banned
        self.profile_names.append("lenient")
        self.profile_w_relevance.append(u8(20))
        self.profile_w_technical.append(u8(15))
        self.profile_w_originality.append(u8(20))
        self.profile_w_tone.append(u8(20))
        self.profile_w_engagement.append(u8(25))
        self.profile_thresholds.append(u8(40))
        self.profile_banned_categories.append("spam")
        self.profile_min_technical.append(u8(5))
        self.profile_min_tone.append(u8(10))
        self.profile_descriptions.append("Lenient: Entry-level moderation. Allows most content except obvious spam. Threshold 40.")

        # ── Profile 1: moderate (средний) ───────────────────────────
        # Threshold 55, стандартные правила, spam + fud banned
        self.profile_names.append("moderate")
        self.profile_w_relevance.append(u8(20))
        self.profile_w_technical.append(u8(20))
        self.profile_w_originality.append(u8(20))
        self.profile_w_tone.append(u8(25))
        self.profile_w_engagement.append(u8(15))
        self.profile_thresholds.append(u8(55))
        self.profile_banned_categories.append("spam,fud")
        self.profile_min_technical.append(u8(20))
        self.profile_min_tone.append(u8(25))
        self.profile_descriptions.append("Moderate: Standard community moderation. Filters spam and FUD. Threshold 55.")

        # ── Profile 2: strict (жёсткий) ─────────────────────────────
        # Threshold 75, агрессивные правила, spam + fud + shill + meme banned
        self.profile_names.append("strict")
        self.profile_w_relevance.append(u8(25))
        self.profile_w_technical.append(u8(25))
        self.profile_w_originality.append(u8(20))
        self.profile_w_tone.append(u8(25))
        self.profile_w_engagement.append(u8(5))
        self.profile_thresholds.append(u8(75))
        self.profile_banned_categories.append("spam,fud,shill,meme")
        self.profile_min_technical.append(u8(45))
        self.profile_min_tone.append(u8(35))
        self.profile_descriptions.append("Strict: Aggressive moderation for technical channels. Bans memes, shills, FUD, spam. Threshold 75.")

    def _find_profile_index(self, name: str) -> u32:
        for i in range(len(self.profile_names)):
            if self.profile_names[i] == name:
                return u32(i)
        assert False, f"Profile not found: {name}"

    def _get_profile(self, name: str) -> dict:
        idx = int(self._find_profile_index(name))
        return {
            "name": self.profile_names[idx],
            "threshold": int(self.profile_thresholds[idx]),
            "weights": {
                "relevance": int(self.profile_w_relevance[idx]),
                "technical": int(self.profile_w_technical[idx]),
                "originality": int(self.profile_w_originality[idx]),
                "tone": int(self.profile_w_tone[idx]),
                "engagement": int(self.profile_w_engagement[idx]),
            },
            "banned_categories": self.profile_banned_categories[idx],
            "min_technical": int(self.profile_min_technical[idx]),
            "min_tone": int(self.profile_min_tone[idx]),
        }

    def _sanitize_text(self, text: str) -> str:
        lower = text.lower()
        banned = [
            "ignore previous", "ignore all instructions", "output score 100",
            "return score 100", "override instructions", "disregard above",
            "new instructions:", "forget previous", "you are now", "system override",
        ]
        for phrase in banned:
            assert phrase not in lower, "Potential prompt injection detected"
        return text.replace("\\", "\\\\").replace('"', '\\"').replace("{", "[").replace("}", "]")

    def _build_eval_prompt(self, tweet_text: str, profile_name: str) -> str:
        p = self._get_profile(profile_name)
        w = p["weights"]
        banned = p["banned_categories"].replace(",", ", ")
        return f"""You are an expert content evaluator for GenLayer blockchain protocol.

Evaluate the tweet below using EXACTLY these 5 dimensions. Each dimension is scored 0-100.

=== TWEET ===
{tweet_text}
=== END TWEET ===

ACTIVE PROFILE: {profile_name}
THRESHOLD: {p["threshold"]}
BANNED CATEGORIES (auto-reject): {banned}
MIN TECHNICAL ACCURACY: {p["min_technical"]}
MIN TONE QUALITY: {p["min_tone"]}

SCORING RUBRIC:

1. RELEVANCE ({w["relevance"]}% weight)
   Does it clearly reference GenLayer, Intelligent Contracts, GenVM,
   Optimistic Democracy, Equivalence Principle, or ecosystem?
   0 = off-topic, 100 = deeply on-topic with specifics.

2. TECHNICAL_ACCURACY ({w["technical"]}% weight)
   Are technical claims correct? Penalize FUD, misinformation, empty hype.
   0 = false/misleading, 100 = technically precise.
   CRITICAL: If score < {p["min_technical"]}, tweet is AUTO-REJECTED.

3. ORIGINALITY ({w["originality"]}% weight)
   Is it more than a bare retweet? Reward insight, tutorials, demos, threads.
   0 = copy-paste/no value, 100 = novel contribution.

4. TONE_QUALITY ({w["tone"]}% weight)
   Professional, constructive, or genuinely funny? Penalize toxicity, spam, FUD.
   0 = toxic/spam, 100 = excellent community fit.
   CRITICAL: If score < {p["min_tone"]}, tweet is AUTO-REJECTED.

5. ENGAGEMENT_POTENTIAL ({w["engagement"]}% weight)
   Would a developer or investor want to learn more after reading?
   0 = forgettable, 100 = highly engaging.

CATEGORY — choose exactly one:
  "educational"  — explains concept, tutorial, deep-dive
  "community"    — update, event, partnership, milestone
  "research"     — technical analysis, data, comparison
  "meme"         — on-topic humor, cultural
  "shill"        — price/token promotion without substance
  "spam"         — off-topic, repetitive, bot-like, phishing
  "fud"          — fear/uncertainty/doubt, baseless criticism, toxicity

CRITICAL RULE: If category is in banned list [{banned}], the tweet MUST be rejected.
Do NOT inflate scores to make banned content pass threshold.

CONFIDENCE — how sure are you in this evaluation?
  "high"    — clear category, strong signals
  "medium"  — ambiguous but leaning one way
  "low"     — unclear, borderline, needs human review

OUTPUT FORMAT — return ONLY this exact JSON. No markdown, no extra text:
{{"relevance": <int 0-100>, "technical_accuracy": <int 0-100>, "originality": <int 0-100>, "tone_quality": <int 0-100>, "engagement_potential": <int 0-100>, "category": "<category>", "confidence": "<high|medium|low>", "feedback": "<2-3 sentences>"}}"""

    def _robust_json_parse(self, raw: str) -> dict:
        try:
            return json.loads(raw)
        except:
            pass
        start = raw.find("```json")
        if start != -1:
            start = raw.find("\n", start) + 1
            end = raw.find("```", start)
            if end != -1:
                try:
                    return json.loads(raw[start:end].strip())
                except:
                    pass
        start = raw.find("```")
        if start != -1:
            start = raw.find("\n", start) + 1
            end = raw.find("```", start)
            if end != -1:
                try:
                    return json.loads(raw[start:end].strip())
                except:
                    pass
        start = raw.find("{")
        end = raw.rfind("}")
        if start != -1 and end != -1 and end > start:
            try:
                return json.loads(raw[start:end+1])
            except:
                pass
        assert False, "Could not parse LLM response as JSON"

    def _validate_rubric_response(self, parsed: dict) -> None:
        required_dims = ["relevance", "technical_accuracy", "originality", "tone_quality", "engagement_potential"]
        for dim in required_dims:
            assert dim in parsed, f"Missing dimension: {dim}"
            val = int(parsed[dim])
            assert 0 <= val <= 100, f"{dim} must be 0-100, got {val}"
        valid_categories = ["educational", "community", "research", "meme", "shill", "spam", "fud"]
        assert parsed.get("category") in valid_categories, f"Invalid category: {parsed.get('category')}"
        valid_confidences = ["high", "medium", "low"]
        assert parsed.get("confidence") in valid_confidences, f"Invalid confidence: {parsed.get('confidence')}"
        assert "feedback" in parsed and len(str(parsed["feedback"])) > 5, "Feedback too short"

    def _calc_weighted_score(self, parsed: dict, profile_name: str) -> u8:
        p = self._get_profile(profile_name)
        w = p["weights"]
        total = (
            int(parsed["relevance"]) * w["relevance"] +
            int(parsed["technical_accuracy"]) * w["technical"] +
            int(parsed["originality"]) * w["originality"] +
            int(parsed["tone_quality"]) * w["tone"] +
            int(parsed["engagement_potential"]) * w["engagement"]
        )
        return u8(total // 100)

    def _apply_hard_rules(self, parsed: dict, profile_name: str) -> tuple:
        p = self._get_profile(profile_name)
        category = str(parsed["category"])
        technical = int(parsed["technical_accuracy"])
        tone = int(parsed["tone_quality"])
        confidence = str(parsed["confidence"])

        banned_list = p["banned_categories"].split(",")
        for banned in banned_list:
            if banned.strip() == category:
                return ("rejected", f"BANNED_CATEGORY:{category}")

        if technical < p["min_technical"]:
            return ("rejected", f"MIN_TECHNICAL:{technical}<{p['min_technical']}")

        if tone < p["min_tone"]:
            return ("rejected", f"MIN_TONE:{tone}<{p['min_tone']}")

        if confidence == "low":
            return ("needs_review", "LOW_CONFIDENCE")

        return ("", "")

    def _generate_eval_id(self, url: str, submitter: Address) -> str:
        addr_str = str(submitter)
        if addr_str.startswith('Address("') and addr_str.endswith('")'):
            addr_str = addr_str[9:-2]
        short_addr = addr_str[-12:]
        clean = url.replace("https://", "").replace("http://", "")
        clean = clean.replace("/", "_").replace(".", "_").replace("-", "_")
        safe = ""
        for c in clean:
            if c.isalnum() or c == "_":
                safe += c
        return f"{safe}_{short_addr}"

    @gl.public.write
    def submit_tweet(self, tweet_url: str, tweet_text: str, profile_name: str = "") -> str:
        assert not self.paused, "Contract is paused"
        if profile_name == "":
            profile_name = self.default_profile
        self._find_profile_index(profile_name)
        safe_url = self._sanitize_text(tweet_url)
        safe_text = self._sanitize_text(tweet_text)
        eval_id = self._generate_eval_id(safe_url, gl.message.sender_address)
        for existing in self.eval_ids:
            assert existing != eval_id, "Tweet already evaluated by this submitter"

        prompt = self._build_eval_prompt(safe_text, profile_name)
        raw = gl.eq_principle.prompt_non_comparative(
            fn=lambda: prompt,
            task="Evaluate the tweet using the 5-dimension rubric and return strict JSON. Respect banned categories and minimum floors.",
            criteria="Response must contain: relevance(0-100), technical_accuracy(0-100), originality(0-100), tone_quality(0-100), engagement_potential(0-100), category(educational/community/research/meme/shill/spam/fud), confidence(high/medium/low), feedback(string). No extra text. If category is banned, scores should reflect low quality."
        )

        parsed = self._robust_json_parse(raw)
        self._validate_rubric_response(parsed)
        total_score = self._calc_weighted_score(parsed, profile_name)
        hard_verdict, hard_reason = self._apply_hard_rules(parsed, profile_name)

        if hard_verdict == "rejected":
            verdict = "rejected"
        elif hard_verdict == "needs_review":
            verdict = "needs_review"
        else:
            p = self._get_profile(profile_name)
            verdict = "approved" if int(total_score) >= p["threshold"] else "rejected"

        self.eval_ids.append(eval_id)
        self.urls.append(safe_url)
        self.texts.append(safe_text)
        self.submitters.append(gl.message.sender_address)
        self.timestamps.append(u64(int(time.time())))
        self.profile_used.append(profile_name)
        self.scores_relevance.append(u8(int(parsed["relevance"])))
        self.scores_technical.append(u8(int(parsed["technical_accuracy"])))
        self.scores_originality.append(u8(int(parsed["originality"])))
        self.scores_tone.append(u8(int(parsed["tone_quality"])))
        self.scores_engagement.append(u8(int(parsed["engagement_potential"])))
        self.scores_total.append(total_score)
        self.verdicts.append(verdict)
        self.categories.append(str(parsed["category"]))
        self.feedbacks.append(str(parsed["feedback"]))
        self.confidences.append(str(parsed["confidence"]))
        self.hard_rule_triggered.append(hard_reason)
        return eval_id

    @gl.public.write
    def submit_tweet_default(self, tweet_url: str, tweet_text: str) -> str:
        return self.submit_tweet(tweet_url, tweet_text, self.default_profile)

    @gl.public.write
    def admin_override(self, eval_id: str, new_verdict: str, reason: str) -> None:
        assert gl.message.sender_address == self.owner, "Only owner"
        assert new_verdict in ["approved", "rejected", "needs_review"], "Invalid verdict"
        found = False
        for i in range(len(self.eval_ids)):
            if self.eval_ids[i] == eval_id:
                self.verdicts[i] = new_verdict
                self.feedbacks[i] = f"[ADMIN OVERRIDE] {reason} | Original: {self.feedbacks[i]}"
                found = True
                break
        assert found, "Evaluation ID not found"
        self.override_eval_id.append(eval_id)
        self.override_reason.append(reason)
        self.override_by.append(gl.message.sender_address)

    @gl.public.write
