    urls: DynArray[str]
    texts: DynArray[str]
    submitters: DynArray[Address]
    timestamps: DynArray[u64]
    profile_used: DynArray[str]
    scores_relevance: DynArray[u8]
    scores_technical: DynArray[u8]
    scores_originality: DynArray[u8]
    scores_tone: DynArray[u8]
    scores_engagement: DynArray[u8]
    scores_total: DynArray[u8]
    verdicts: DynArray[str]
    categories: DynArray[str]
    feedbacks: DynArray[str]
