    @gl.public.view
    def get_stats(self) -> str:
        total = len(self.scores_total)
        if total == 0:
            return json.dumps({
                "total": 0, "approved": 0, "rejected": 0, "needs_review": 0,
                "hard_rule_rejections": 0, "threshold_rejections": 0,
                "avg_total_score": 0,
            })
        approved = sum(1 for v in self.verdicts if v == "approved")
        rejected = sum(1 for v in self.verdicts if v == "rejected")
        needs_review = sum(1 for v in self.verdicts if v == "needs_review")
        hard_rule_rejections = sum(1 for r in self.hard_rule_triggered if r != "")
        threshold_rejections = rejected - hard_rule_rejections
        avg_total = sum(int(s) for s in self.scores_total) // total
        return json.dumps({
            "total": total, "approved": approved, "rejected": rejected,
            "needs_review": needs_review,
            "hard_rule_rejections": hard_rule_rejections,
            "threshold_rejections": threshold_rejections,
            "avg_total_score": avg_total,
        })

