    profile_thresholds: DynArray[u8]
    profile_w_relevance: DynArray[u8]
    profile_w_technical: DynArray[u8]
    profile_w_originality: DynArray[u8]
    profile_w_tone: DynArray[u8]
    profile_w_engagement: DynArray[u8]
    profile_banned_categories: DynArray[str]
    profile_min_technical: DynArray[u8]
    profile_min_tone: DynArray[u8]
    profile_descriptions: DynArray[str]
