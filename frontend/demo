  const lbl=document.getElementById('st-btn-lbl')
  btn.disabled=true
  lbl.innerHTML='<span class="spinner"></span> Evaluating…'
  await sleep(900)
  const p=PROFILES[pname]
  const {dims,cat}=scoreTweet(text)
  await sleep(400)
  const result=applyProfile(dims,cat,p)
  const id=genId(url,'0x'+Math.random().toString(16).slice(2,10))
  const entry={eval_id:id,url,text,submitter:'0xUSER',timestamp:Math.floor(Date.now()/1000),
