function drawDonut(svgId, legendId, data, total) {
  const svg = document.getElementById(svgId)
  const legend = document.getElementById(legendId)
  const cx=60,cy=60,r=45,inner=28
  let cum=0, paths='', legendHtml=''
  data.forEach(([label,val,color]) => {
    const pct=val/total
    const start=cum*2*Math.PI-Math.PI/2, end=(cum+pct)*2*Math.PI-Math.PI/2
    const x1=cx+r*Math.cos(start),y1=cy+r*Math.sin(start)
    const x2=cx+r*Math.cos(end),y2=cy+r*Math.sin(end)
    const la=pct>.5?1:0
    if(pct>0.001) paths+=`<path d="M${cx} ${cy}L${x1} ${y1}A${r} ${r} 0 ${la} 1 ${x2} ${y2}Z" fill="${color}" opacity=".85"/>`
    cum+=pct
    legendHtml+=`<div class="legend-item"><span class="legend-dot" style="background:${color}"></span><span class="legend-lbl">${label}</span><span class="legend-val">${val}</span><span class="legend-pct">${Math.round(pct*100)}%</span></div>`
  })
  svg.innerHTML = paths + `<circle cx="${cx}" cy="${cy}" r="${inner}" fill="var(--card)"/>
  <text x="${cx}" y="${cy-3}" text-anchor="middle" fill="var(--text)" font-size="14" font-weight="600" font-family="Syne,sans-serif">${total}</text>
  <text x="${cx}" y="${cy+11}" text-anchor="middle" fill="#6b7280" font-size="8">total</text>`
  legend.innerHTML = legendHtml
}

// ─── PROFILES ───────────────────────────────────────────────────────────────
function initProfiles() {
  switchProfile('lenient', document.querySelector('.profile-tab.active') || document.querySelector('.profile-tab'))
}

function switchProfile(name, btn) {
  currentProfile = name
  document.querySelectorAll('.profile-tab').forEach(t=>t.classList.remove('active'))
  if(btn) btn.classList.add('active')
  const p = PROFILES[name]
  document.getElementById('profile-name-title').textContent = capitalize(name) + ' Profile'
  document.getElementById('profile-desc-text').textContent = p.desc
  document.getElementById('threshold-input').value = p.threshold
  document.getElementById('min-tech-input').value = p.minTech
  document.getElementById('min-tone-input').value = p.minTone
  renderBannedTags(name)
  renderWeightSliders(name)
  updateProfilePreview()
  renderProfileCompare()
}

function renderWeightSliders(profileName) {
  const p = PROFILES[profileName]
  const wrap = document.getElementById('weight-sliders')
  wrap.innerHTML = DIMS.map(d=>`
  <div class="slider-row">
    <span class="slider-name">${DIM_LABELS[d]}</span>
    <input class="slider-input" type="range" min="0" max="100" step="1" value="${p.weights[d]}" 
      style="accent-color:${DIM_COLORS[d]}"
      oninput="onWeightChange('${d}',this.value,'${profileName}')">
    <span class="slider-val" id="val-${d}">${p.weights[d]}</span>
  </div>`).join('')
  updateSumIndicator(profileName)
}

function onWeightChange(dim, val, profileName) {
  PROFILES[profileName].weights[dim] = parseInt(val)
  document.getElementById('val-'+dim).textContent = val
  updateSumIndicator(profileName)
  updateProfilePreview()
  renderWeightStripPreview(profileName)
}

function updateSumIndicator(profileName) {
  const p = PROFILES[profileName]
  const sum = Object.values(p.weights).reduce((a,b)=>a+b,0)
  const el = document.getElementById('sum-indicator')
  el.textContent = `Sum: ${sum} ${sum===100?'✓':'— must equal 100'}`
  el.className = 'sum-indicator ' + (sum===100?'sum-ok':'sum-bad')
}

function renderBannedTags(profileName) {
  const p = PROFILES[profileName]
  const wrap = document.getElementById('banned-tags-wrap')
  wrap.innerHTML = p.banned.map(b=>`
  <span class="banned-tag">${b}<button onclick="removeBanned('${b}','${profileName}')">×</button></span>`).join('')
}

function addBanned() {
  const sel = document.getElementById('banned-add-input')
  const val = sel.value
  if(!val) return
  const p = PROFILES[currentProfile]
  if(!p.banned.includes(val)) { p.banned.push(val); renderBannedTags(currentProfile); updateProfilePreview() }
  sel.value = ''
}

function removeBanned(cat, profileName) {
  const p = PROFILES[profileName]
  p.banned = p.banned.filter(b=>b!==cat)
  renderBannedTags(profileName)
  updateProfilePreview()
}

function renderWeightStripPreview(profileName) {
  const p = PROFILES[profileName||currentProfile]
  const strip = document.getElementById('weight-strip-preview')
  if(!strip) return
  strip.innerHTML = DIMS.map(d=>`
  <div class="weight-seg" style="width:${p.weights[d]}%;background:${DIM_COLORS[d]};min-width:${p.weights[d]>0?'12px':'0'}">
    ${p.weights[d]>10?p.weights[d]:''}
  </div>`).join('')

  const legend = document.getElementById('weight-legend')
  if(legend) legend.innerHTML = DIMS.map(d=>`
  <div style="display:flex;align-items:center;gap:7px;font-size:12px">
    <span style="width:10px;height:10px;border-radius:2px;background:${DIM_COLORS[d]};display:inline-block;flex-shrink:0"></span>
    <span style="color:var(--muted);flex:1">${DIM_LABELS[d]}</span>
    <span style="font-family:'JetBrains Mono',monospace;color:var(--text)">${p.weights[d]}%</span>
  </div>`).join('')
}

function updateProfilePreview() {
  renderWeightStripPreview(currentProfile)
  const p = PROFILES[currentProfile]
  // Simulate sample tweet
  const sampleDims = {relevance:88,technical:78,originality:72,tone:85,engagement:75}
  const score = Math.round(DIMS.reduce((acc,d)=>acc+(sampleDims[d]*p.weights[d]/100),0))
  const simScores = document.getElementById('profile-sim-scores')
  if(!simScores) return
  simScores.innerHTML = DIMS.map(d=>{
    const v=sampleDims[d], c=v>=70?'var(--green)':v>=40?'var(--amber)':'var(--red)'
    return `<div class="sbar-wrap">
      <div class="sbar-row"><span class="sbar-lbl">${DIM_LABELS[d]}</span><div style="display:flex;gap:6px"><span style="font-size:10px;color:var(--muted)">${p.weights[d]}% → ${Math.round(v*p.weights[d]/100)}pts</span><span style="font-family:'JetBrains Mono',monospace;font-size:11px;color:${c}">${v}</span></div></div>
      <div class="sbar-track"><div class="sbar-fill" style="width:${v}%;background:${c}"></div></div>
    </div>`
  }).join('')

  const total = document.getElementById('profile-sim-total')
  if(total) { total.textContent = score+'/100'; total.style.color = score>=p.threshold?'var(--green)':'var(--red)' }

  const verdict = document.getElementById('profile-verdict-preview')
  if(verdict) verdict.innerHTML = score>=p.threshold
    ? `<span class="badge-lbl v-pass">✓ APPROVED — ${score} ≥ ${p.threshold}</span>`
    : `<span class="badge-lbl v-fail">✗ REJECTED — ${score} < ${p.threshold}</span>`
}

function renderProfileCompare() {
  const tbody = document.getElementById('profile-compare-table')
  if(!tbody) return
  tbody.innerHTML = Object.values(PROFILES).map(p=>`
  <tr style="${p.name===currentProfile?'background:rgba(124,58,237,.08)':''}">
    <td style="font-weight:600;color:${p.color}">${capitalize(p.name)}</td>
    <td style="font-family:'JetBrains Mono',monospace">${p.threshold}</td>
    <td style="font-family:'JetBrains Mono',monospace;color:var(--red);font-size:10.5px">${p.banned.join(',')}</td>
    <td style="font-family:'JetBrains Mono',monospace;color:${p.color}">${p.realRate.toFixed(1)}%</td>
  </tr>`).join('')
}

function saveProfile() {
  const p = PROFILES[currentProfile]
  const sum = Object.values(p.weights).reduce((a,b)=>a+b,0)
  if(sum!==100) { showSaveMsg('Weights must sum to 100','red'); return }
  p.threshold = parseInt(document.getElementById('threshold-input').value)
  p.minTech = parseInt(document.getElementById('min-tech-input').value)
  p.minTone = parseInt(document.getElementById('min-tone-input').value)
  updateProfilePreview()
  showSaveMsg('Profile saved ✓', 'green')
}

function showSaveMsg(msg, type) {
  const el = document.getElementById('save-msg')
  el.style.display='block'
  el.innerHTML=`<div class="alert alert-${type}">${msg}</div>`
  setTimeout(()=>el.style.display='none', 2500)
}

// ─── UTILS ──────────────────────────────────────────────────────────────────
function getCatBadge(cat) {
  const m={educational:'badge-edu',community:'badge-com',research:'badge-res',meme:'badge-meme',spam:'badge-spam',fud:'badge-fud',shill:'badge-shill'}
  return m[cat]||'badge-edu'
}
function capitalize(s){return s.charAt(0).toUpperCase()+s.slice(1)}
function sleep(ms){return new Promise(r=>setTimeout(r,ms))}
function showQuickAlert(msg,type){
  const a=document.createElement('div')
  a.className='alert alert-'+type
  a.textContent=msg
  a.style.cssText='position:fixed;top:20px;right:20px;z-index:9999;min-width:240px'
  document.body.appendChild(a)
  setTimeout(()=>a.remove(),3000)
}

// ─── INIT ───────────────────────────────────────────────────────────────────
renderOverview()
initSubmit()

// Init profiles page silently
setTimeout(()=>{
  renderWeightStripPreview('lenient')
  updateProfilePreview()
  renderProfileCompare()
},100)
</script>
