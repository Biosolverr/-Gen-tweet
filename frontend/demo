<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width,initial-scale=1.0">
<title>GenLayer TweetEvaluator v3 — Studio</title>
<style>
@import url('https://fonts.googleapis.com/css2?family=Syne:wght@600;700;800&family=DM+Sans:wght@400;500;600&family=JetBrains+Mono:wght@400;500&display=swap');
*{box-sizing:border-box;margin:0;padding:0}
:root{
  --bg:#09090f;--s1:#0d0d16;--s2:#11111c;--s3:#161625;--border:#1f1f30;
  --acc:#7c3aed;--acc2:#a78bfa;--accg:rgba(124,58,237,.12);
  --t1:#e8e8f0;--t2:#9494a8;--t3:#52526a;
  --green:#10b981;--red:#ef4444;--amber:#f59e0b;--blue:#60a5fa;
}
html,body{background:var(--bg);color:var(--t1);font-family:'DM Sans',sans-serif;min-height:100vh;font-size:13px}
::-webkit-scrollbar{width:4px;height:4px}::-webkit-scrollbar-track{background:var(--s1)}::-webkit-scrollbar-thumb{background:var(--border);border-radius:2px}

/* ── SHELL ── */
.shell{display:flex;height:100vh;overflow:hidden}
.sidebar{width:220px;flex-shrink:0;background:var(--s1);border-right:1px solid var(--border);display:flex;flex-direction:column;overflow-y:auto}
.main{flex:1;display:flex;flex-direction:column;overflow:hidden}
.topbar{height:48px;flex-shrink:0;background:var(--s1);border-bottom:1px solid var(--border);display:flex;align-items:center;padding:0 18px;gap:12px}
.body{flex:1;overflow-y:auto;display:flex;min-height:0}
.left-pane{width:280px;flex-shrink:0;border-right:1px solid var(--border);overflow-y:auto;display:flex;flex-direction:column}
.right-pane{flex:1;overflow-y:auto;padding:20px}

/* ── SIDEBAR ── */
.sb-logo{padding:16px;border-bottom:1px solid var(--border);display:flex;align-items:center;gap:9px}
.sb-hex{width:22px;height:22px;flex-shrink:0}
.sb-title{font-family:'Syne',sans-serif;font-size:13px;font-weight:700;color:#c4b5fd}
.sb-sub{font-size:9.5px;color:var(--t3);font-family:'JetBrains Mono',monospace;margin-top:2px}
.sb-section{padding:10px 10px 4px;font-size:9px;font-weight:600;color:var(--t3);text-transform:uppercase;letter-spacing:.1em}
.sb-item{display:flex;align-items:center;gap:8px;padding:8px 12px;cursor:pointer;color:var(--t2);border-left:2px solid transparent;transition:all .12s;font-size:12px;background:none;border-top:none;border-bottom:none;border-right:none;width:100%;text-align:left}
.sb-item:hover{color:var(--t1);background:var(--accg)}
.sb-item.active{color:var(--acc2);border-left-color:var(--acc);background:var(--accg)}
.sb-item .badge-count{margin-left:auto;background:var(--s3);color:var(--t3);font-size:9px;font-family:'JetBrains Mono',monospace;padding:1px 5px;border-radius:3px}
.sb-tag{display:inline-block;padding:1px 6px;border-radius:3px;font-size:9px;font-weight:600}
.sb-tag.write{background:rgba(239,68,68,.15);color:#f87171}
.sb-tag.read{background:rgba(96,165,250,.12);color:#60a5fa}
.sb-foot{margin-top:auto;padding:12px;border-top:1px solid var(--border)}
.status-dot{width:6px;height:6px;border-radius:50%;background:var(--green);display:inline-block;animation:pulse 2s infinite;margin-right:5px}
@keyframes pulse{0%,100%{opacity:1}50%{opacity:.3}}

/* ── TOPBAR ── */
.tb-contract{font-family:'JetBrains Mono',monospace;font-size:11px;color:var(--t3)}
.tb-addr{font-family:'JetBrains Mono',monospace;font-size:11px;color:var(--acc2);background:var(--accg);border:1px solid rgba(124,58,237,.25);padding:3px 8px;border-radius:5px}
.tb-sep{color:var(--border);font-size:16px}
.tb-btn{padding:5px 12px;border-radius:6px;font-size:11.5px;font-weight:500;cursor:pointer;border:1px solid var(--border);background:var(--s2);color:var(--t2);font-family:'DM Sans',sans-serif;transition:all .12s}
.tb-btn:hover{color:var(--t1);border-color:var(--t3)}
.tb-btn.primary{background:var(--acc);color:#fff;border-color:var(--acc)}
.tb-btn.primary:hover{background:#6d28d9}
.state-badge{display:flex;align-items:center;gap:5px;font-size:10px;color:var(--green);background:rgba(16,185,129,.1);border:1px solid rgba(16,185,129,.2);padding:3px 8px;border-radius:5px;margin-left:auto}

/* ── METHOD PANEL ── */
.method-group{padding:12px}
.method-group-title{font-size:9px;font-weight:600;color:var(--t3);text-transform:uppercase;letter-spacing:.1em;margin-bottom:8px;display:flex;align-items:center;gap:6px}
.method-card{border-radius:8px;border:1px solid var(--border);background:var(--s2);margin-bottom:6px;overflow:hidden;cursor:pointer;transition:border-color .12s}
.method-card:hover{border-color:var(--acc)40}
.method-card.active{border-color:var(--acc);background:var(--s3)}
.method-header{display:flex;align-items:center;gap:8px;padding:9px 12px}
.method-name{font-family:'JetBrains Mono',monospace;font-size:12px;font-weight:500;flex:1}
.method-type{font-size:9px;font-weight:600;padding:1px 5px;border-radius:3px}
.mt-read{background:rgba(96,165,250,.12);color:#60a5fa}
.mt-write{background:rgba(239,68,68,.12);color:#f87171}

/* ── RIGHT PANE ── */
.pane-title{font-family:'Syne',sans-serif;font-size:16px;font-weight:700;color:var(--t1);margin-bottom:4px}
.pane-sub{font-size:11.5px;color:var(--t3);margin-bottom:18px}
.section-card{background:var(--s2);border:1px solid var(--border);border-radius:10px;padding:16px;margin-bottom:14px}
.sc-title{font-size:10px;font-weight:600;color:var(--t3);text-transform:uppercase;letter-spacing:.07em;margin-bottom:12px}

/* ── FORM ── */
.field{display:flex;flex-direction:column;gap:5px;margin-bottom:12px}
.field:last-child{margin-bottom:0}
.field label{font-size:10px;font-weight:600;color:var(--t3);text-transform:uppercase;letter-spacing:.06em}
input.fi,textarea.fi,select.fi{background:var(--bg);border:1px solid var(--border);border-radius:7px;padding:8px 11px;font-size:12.5px;color:var(--t1);font-family:'DM Sans',sans-serif;outline:none;width:100%;transition:border-color .12s}
input.fi:focus,textarea.fi:focus,select.fi:focus{border-color:rgba(124,58,237,.5)}
input.fi::placeholder,textarea.fi::placeholder{color:var(--t3)}
textarea.fi{resize:vertical;line-height:1.6;min-height:90px}
select.fi{cursor:pointer}
.btn{display:inline-flex;align-items:center;justify-content:center;gap:6px;padding:8px 16px;border-radius:7px;font-size:12.5px;font-weight:500;cursor:pointer;font-family:'DM Sans',sans-serif;transition:all .12s;border:1px solid transparent}
.btn-primary{background:var(--acc);color:#fff;border-color:var(--acc)}
.btn-primary:hover{background:#6d28d9}
.btn-danger{background:rgba(239,68,68,.12);color:#f87171;border-color:rgba(239,68,68,.25)}
.btn-danger:hover{background:rgba(239,68,68,.2)}
.btn-sec{background:var(--s3);color:var(--t2);border-color:var(--border)}
.btn-sec:hover{color:var(--t1)}
.btn:disabled{opacity:.4;cursor:not-allowed}
.btn-full{width:100%}
.spinner{width:13px;height:13px;border:2px solid rgba(255,255,255,.2);border-top-color:#fff;border-radius:50%;animation:spin .6s linear infinite}
@keyframes spin{to{transform:rotate(360deg)}}

/* ── OUTPUT ── */
.output-box{background:var(--bg);border:1px solid var(--border);border-radius:8px;padding:14px;font-family:'JetBrains Mono',monospace;font-size:11.5px;line-height:1.7;color:var(--t2);white-space:pre-wrap;word-break:break-all;max-height:420px;overflow-y:auto}
.output-empty{color:var(--t3);font-style:italic}
.output-label{font-size:9.5px;font-weight:600;color:var(--t3);text-transform:uppercase;letter-spacing:.07em;margin-bottom:6px;display:flex;align-items:center;justify-content:space-between}
.copy-btn{cursor:pointer;color:var(--t3);font-size:10px;background:none;border:none;font-family:'JetBrains Mono',monospace;padding:0}
.copy-btn:hover{color:var(--acc2)}

/* ── RESULT ── */
.result-verdict{display:flex;align-items:flex-start;gap:14px;padding:14px;border-radius:8px;border:1px solid;margin-bottom:12px}
.rv-approved{background:rgba(16,185,129,.08);border-color:rgba(16,185,129,.3)}
.rv-rejected{background:rgba(239,68,68,.07);border-color:rgba(239,68,68,.25)}
.rv-score{font-family:'Syne',sans-serif;font-size:40px;font-weight:800;line-height:1}
.rv-badge{display:inline-flex;align-items:center;gap:5px;font-size:10.5px;font-weight:600;padding:3px 9px;border-radius:4px}
.vb-approved{background:#052e16;color:#4ade80;border:1px solid #166534}
.vb-rejected{background:#300505;color:#f87171;border:1px solid #7f1d1d}
.dim-bar-row{margin-bottom:9px}
.dim-bar-top{display:flex;justify-content:space-between;font-size:11px;margin-bottom:3px}
.dim-bar-lbl{color:var(--t2)}
.dim-bar-track{height:4px;background:var(--border);border-radius:2px;overflow:hidden}
.dim-bar-fill{height:100%;border-radius:2px;transition:width .5s}
.hard-rule{background:rgba(239,68,68,.1);border:1px solid rgba(239,68,68,.25);border-radius:7px;padding:9px 12px;margin-bottom:10px}
.hard-rule-title{font-size:9.5px;font-weight:600;color:#f87171;text-transform:uppercase;letter-spacing:.06em;margin-bottom:3px}
.hard-rule-val{font-family:'JetBrains Mono',monospace;font-size:11.5px;color:#fca5a5}

/* ── BADGES ── */
.badge{display:inline-flex;align-items:center;padding:2px 7px;border-radius:4px;font-size:10px;font-family:'JetBrains Mono',monospace;font-weight:500;white-space:nowrap}
.b-edu{background:#1a3a6e22;color:#60a5fa;border:1px solid #1a3a6e55}
.b-com{background:#2e1a6e22;color:#a78bfa;border:1px solid #2e1a6e55}
.b-res{background:#064e3b22;color:#34d399;border:1px solid #064e3b55}
.b-meme{background:#42200622;color:#fbbf24;border:1px solid #42200655}
.b-spam{background:#45000022;color:#f87171;border:1px solid #45000055}
.b-fud{background:#45000022;color:#fca5a5;border:1px solid #45000055}
.b-shill{background:#7c1f0022;color:#fb923c;border:1px solid #7c1f0055}

/* ── GRID ── */
.g2{display:grid;grid-template-columns:1fr 1fr;gap:10px}
.g3{display:grid;grid-template-columns:1fr 1fr 1fr;gap:10px}
.g4{display:grid;grid-template-columns:repeat(4,1fr);gap:10px}

/* ── STAT ── */
.stat{background:var(--s2);border:1px solid var(--border);border-radius:8px;padding:12px}
.stat-lbl{font-size:9.5px;font-weight:600;color:var(--t3);text-transform:uppercase;letter-spacing:.06em}
.stat-val{font-family:'Syne',sans-serif;font-size:22px;font-weight:700;margin-top:4px;line-height:1}
.stat-sub{font-size:10.5px;color:var(--t3);margin-top:2px}

/* ── TABS ── */
.tabs{display:flex;border-bottom:1px solid var(--border);margin-bottom:14px}
.tab{padding:8px 14px;font-size:12px;color:var(--t3);cursor:pointer;border-bottom:2px solid transparent;background:none;border-top:none;border-left:none;border-right:none;font-family:'DM Sans',sans-serif;transition:all .12s}
.tab.active{color:var(--acc2);border-bottom-color:var(--acc)}
.tab:hover:not(.active){color:var(--t2)}

/* ── TABLE ── */
.tbl{width:100%;border-collapse:collapse;font-size:11.5px}
.tbl th{text-align:left;font-size:9.5px;font-weight:600;color:var(--t3);text-transform:uppercase;letter-spacing:.06em;padding:6px 10px;border-bottom:1px solid var(--border)}
.tbl td{padding:8px 10px;border-bottom:1px solid #1a1a28;vertical-align:middle}
.tbl tr:last-child td{border-bottom:none}
.tbl tr:hover td{background:#ffffff03}
.mono{font-family:'JetBrains Mono',monospace}

/* ── EVAL DETAIL ── */
.eval-detail-wrap{display:grid;grid-template-columns:1fr 280px;gap:14px;align-items:start}

/* ── WEIGHT STRIP ── */
.wstrip{display:flex;height:16px;border-radius:4px;overflow:hidden;gap:1px;margin:8px 0}
.wseg{display:flex;align-items:center;justify-content:center;font-size:8px;font-weight:700;color:#fff;min-width:0;transition:width .4s}

/* ── PROFILE CARD ── */
.profile-card{background:var(--s2);border:1px solid var(--border);border-radius:10px;padding:14px;margin-bottom:10px}
.profile-card.active-p{border-color:var(--acc)40;background:var(--s3)}

/* misc */
.divider{border:none;border-top:1px solid var(--border);margin:14px 0}
.pill{display:inline-flex;align-items:center;gap:4px;background:var(--s3);border:1px solid var(--border);border-radius:20px;padding:2px 9px;font-size:10.5px;color:var(--t2);margin:2px}
.pill button{background:none;border:none;color:var(--t3);cursor:pointer;font-size:11px;line-height:1;padding:0}
.pill button:hover{color:var(--red)}
.kbd{background:var(--s3);border:1px solid var(--border);border-radius:4px;padding:1px 5px;font-family:'JetBrains Mono',monospace;font-size:10px;color:var(--t2)}
</style>
</head>
<body>
<div class="shell">

<!-- ════ SIDEBAR ════ -->
<aside class="sidebar">
  <div class="sb-logo">
    <svg class="sb-hex" viewBox="0 0 26 26" fill="none">
      <polygon points="13,2 24,8 24,18 13,24 2,18 2,8" fill="rgba(124,58,237,.2)" stroke="#7c3aed" stroke-width="1.5"/>
      <polygon points="13,7 20,10.5 20,15.5 13,19 6,15.5 6,10.5" fill="#7c3aed" opacity=".8"/>
    </svg>
    <div><div class="sb-title">GenLayer</div><div class="sb-sub">TweetEvaluator_v3</div></div>
  </div>

  <div class="sb-section">Contract</div>
  <button class="sb-item active" onclick="nav('overview',this)">◈ Overview</button>

  <div class="sb-section">Read Methods</div>
  <button class="sb-item" onclick="nav('get_stats',this)"><span class="sb-tag read">R</span> get_stats</button>
  <button class="sb-item" onclick="nav('get_config',this)"><span class="sb-tag read">R</span> get_config</button>
  <button class="sb-item" onclick="nav('get_count',this)"><span class="sb-tag read">R</span> get_count</button>
  <button class="sb-item" onclick="nav('get_profiles',this)"><span class="sb-tag read">R</span> get_profiles</button>
  <button class="sb-item" onclick="nav('get_profile',this)"><span class="sb-tag read">R</span> get_profile</button>
  <button class="sb-item" onclick="nav('get_evaluation',this)"><span class="sb-tag read">R</span> get_evaluation</button>
  <button class="sb-item" onclick="nav('get_evaluation_by_id',this)"><span class="sb-tag read">R</span> get_evaluation_by_id</button>
  <button class="sb-item" onclick="nav('get_approved_urls',this)"><span class="sb-tag read">R</span> get_approved_urls</button>
  <button class="sb-item" onclick="nav('get_by_category',this)"><span class="sb-tag read">R</span> get_by_category</button>
  <button class="sb-item" onclick="nav('get_category_breakdown',this)"><span class="sb-tag read">R</span> get_category_breakdown</button>
  <button class="sb-item" onclick="nav('get_profile_breakdown',this)"><span class="sb-tag read">R</span> get_profile_breakdown</button>
  <button class="sb-item" onclick="nav('get_hard_rule_breakdown',this)"><span class="sb-tag read">R</span> get_hard_rule_breakdown</button>
  <button class="sb-item" onclick="nav('get_needs_review',this)"><span class="sb-tag read">R</span> get_needs_review</button>
  <button class="sb-item" onclick="nav('get_overrides',this)"><span class="sb-tag read">R</span> get_overrides</button>
  <button class="sb-item" onclick="nav('get_top_scores',this)"><span class="sb-tag read">R</span> get_top_scores</button>

  <div class="sb-section">Write Methods <span class="sb-tag write" style="font-size:8px">Simulation</span></div>
  <button class="sb-item" onclick="nav('submit_tweet',this)"><span class="sb-tag write">W</span> submit_tweet</button>
  <button class="sb-item" onclick="nav('submit_tweet_default',this)"><span class="sb-tag write">W</span> submit_tweet_default</button>
  <button class="sb-item" onclick="nav('admin_override',this)"><span class="sb-tag write">W</span> admin_override</button>
  <button class="sb-item" onclick="nav('set_profile_weights',this)"><span class="sb-tag write">W</span> set_profile_weights</button>
  <button class="sb-item" onclick="nav('set_profile_threshold',this)"><span class="sb-tag write">W</span> set_profile_threshold</button>
  <button class="sb-item" onclick="nav('set_profile_rules',this)"><span class="sb-tag write">W</span> set_profile_rules</button>
  <button class="sb-item" onclick="nav('set_profile_description',this)"><span class="sb-tag write">W</span> set_profile_description</button>
  <button class="sb-item" onclick="nav('set_default_profile',this)"><span class="sb-tag write">W</span> set_default_profile</button>
  <button class="sb-item" onclick="nav('toggle_pause',this)"><span class="sb-tag write">W</span> toggle_pause</button>

  <div class="sb-foot">
    <div style="display:flex;align-items:center;gap:6px;font-size:11px;color:var(--t3)">
      <span class="status-dot"></span>Simulation Mode · No contract
    </div>
    <div style="font-size:9.5px;color:var(--t3);margin-top:4px;font-family:'JetBrains Mono',monospace">0x9b...96e1</div>
  </div>
</aside>

<!-- ════ MAIN ════ -->
<div class="main">
  <!-- topbar -->
  <div class="topbar">
    <span class="tb-contract">GenLayerTweetEvaluator_v3.py</span>
    <span class="tb-sep">|</span>
    <span style="font-size:11px;color:var(--t3)">Deployed at</span>
    <span class="tb-addr">0x9b...96e1</span>
    <button class="tb-btn" onclick="showToast('Deploy not available in simulation mode')">Deploy new instance</button>
    <button class="tb-btn" onclick="showToast('Upgrade not available in simulation mode')">Upgrade code</button>
    <div class="state-badge"><span class="status-dot" style="width:5px;height:5px"></span>AcceptedFinalized</div>
  </div>

  <!-- body -->
  <div class="body">
    <!-- LEFT: method list pane (for Read/Write detail) -->
    <div class="left-pane" id="left-pane" style="display:none">
      <div style="padding:12px;border-bottom:1px solid var(--border)">
        <div style="font-size:10px;font-weight:600;color:var(--t3);text-transform:uppercase;letter-spacing:.07em;margin-bottom:6px" id="lp-section-title">Read Methods</div>
        <div id="lp-method-list"></div>
      </div>
    </div>

    <!-- RIGHT: content -->
    <div class="right-pane" id="right-pane"></div>
  </div>
</div>

</div><!-- /shell -->

<!-- TOAST -->
<div id="toast" style="display:none;position:fixed;bottom:20px;right:20px;background:var(--s3);border:1px solid var(--border);border-radius:8px;padding:10px 16px;font-size:12px;color:var(--t2);z-index:9999;max-width:320px"></div>

<script>
// ════════════════════════════════════════════════════════
// DATA / STATE
// ════════════════════════════════════════════════════════
const PROFILES = {
  lenient:{name:'lenient',desc:'Entry-level moderation. Allows most content except obvious spam. Threshold 40.',
    threshold:40,weights:{relevance:20,technical:15,originality:20,tone:20,engagement:25},
    banned:['spam'],minTech:5,minTone:10,color:'#10b981',isDefault:false},
  moderate:{name:'moderate',desc:'Standard community moderation. Filters spam and FUD. Threshold 55.',
    threshold:55,weights:{relevance:20,technical:20,originality:20,tone:25,engagement:15},
    banned:['spam','fud'],minTech:20,minTone:25,color:'#7c3aed',isDefault:true},
  strict:{name:'strict',desc:'Aggressive moderation for technical channels. Bans memes, shills, FUD, spam. Threshold 75.',
    threshold:75,weights:{relevance:25,technical:25,originality:20,tone:25,engagement:5},
    banned:['spam','fud','shill','meme'],minTech:45,minTone:35,color:'#ef4444',isDefault:false},
}
const DIMS = ['relevance','technical','originality','tone','engagement']
const DLABELS = {relevance:'Relevance',technical:'Technical Accuracy',originality:'Originality',tone:'Tone Quality',engagement:'Engagement Potential'}
const DCOLORS = {relevance:'#60a5fa',technical:'#34d399',originality:'#a78bfa',tone:'#fbbf24',engagement:'#f87171'}
const CATMAP = {educational:'b-edu',community:'b-com',research:'b-res',meme:'b-meme',spam:'b-spam',fud:'b-fud',shill:'b-shill'}

let STATE = {
  evaluations:[],
  overrides:[],
  paused:false,
  defaultProfile:'moderate',
  nextIdx:0,
}

// seed some evaluations
function seedData(){
  const seeds=[
    {url:'https://x.com/builder/status/A1',text:'Deep dive into GenLayer\'s Equivalence Principle — heterogeneous AI validators reaching deterministic consensus. Benchmark data included.',dims:{relevance:92,technical:82,originality:88,tone:85,engagement:90},cat:'research',profile:'strict'},
    {url:'https://x.com/team/status/C2',text:'🚀 GenLayer Testnet: 394 validators live. Optimistic Democracy consensus time down 40%. Full metrics: [link]',dims:{relevance:88,technical:78,originality:62,tone:90,engagement:84},cat:'community',profile:'moderate'},
    {url:'https://x.com/meme/status/B1',text:'GenLayer validators when tweet is ambiguous 😭 [meme image]',dims:{relevance:60,technical:12,originality:70,tone:72,engagement:85},cat:'meme',profile:'lenient'},
    {url:'https://x.com/spam/status/S1',text:'🚨 FREE TOKENS follow+RT for airdrop LIMITED TIME!!!',dims:{relevance:8,technical:0,originality:5,tone:5,engagement:20},cat:'spam',profile:'moderate'},
    {url:'https://x.com/dev/status/D3',text:'Formal verification of GenVM execution model. Proved soundness + completeness. 10M test cases, zero counter-examples.',dims:{relevance:95,technical:90,originality:90,tone:90,engagement:85},cat:'research',profile:'strict'},
  ]
  seeds.forEach(s=>{
    const p=PROFILES[s.profile]
    const result=applyProfile(s.dims,s.cat,p)
    const id=genId(s.url,'0x'+Math.random().toString(16).slice(2,10))
    STATE.evaluations.push({eval_id:id,url:s.url,text:s.text,submitter:'0xSEED'+STATE.nextIdx++,
      timestamp:Math.floor(Date.now()/1000)-Math.floor(Math.random()*86400),
      profile:s.profile,dimensions:s.dims,total_score:result.score,
      verdict:result.verdict,category:s.cat,confidence:'high',feedback:getFeedback(s.cat,result.verdict,s.dims),
      hard_rule_triggered:result.hardRule||''})
  })
}

function genId(url,addr){
  const clean=url.replace(/https?:\/\//,'').replace(/[^a-zA-Z0-9]/g,'_').slice(0,30)
  return clean+'_'+addr.slice(-8)
}

function applyProfile(dims,cat,profile){
  const w=profile.weights
  const score=Math.round(DIMS.reduce((acc,d)=>acc+(dims[d]*w[d]/100),0))
  if(profile.banned.includes(cat)) return{verdict:'rejected',score,hardRule:`BANNED_CATEGORY:${cat}`,confidence:'high'}
  if(dims.technical<profile.minTech) return{verdict:'rejected',score,hardRule:`MIN_TECHNICAL:${dims.technical}<${profile.minTech}`,confidence:'high'}
  if(dims.tone<profile.minTone) return{verdict:'rejected',score,hardRule:`MIN_TONE:${dims.tone}<${profile.minTone}`,confidence:'high'}
  const conf=Math.abs(score-profile.threshold)<8?'medium':'high'
  const conf2=conf==='medium'&&score<profile.threshold?'needs_review':null
  if(conf2) return{verdict:'needs_review',score,hardRule:'LOW_CONFIDENCE',confidence:'low'}
  return{verdict:score>=profile.threshold?'approved':'rejected',score,hardRule:'',confidence:conf}
}

function scoreTweet(text){
  const l=text.toLowerCase()
  const gl=['genlayer','equivalence principle','genvm','intelligent contract','optimistic democracy','validator']
  const tech=['consensus','algorithm','proof','benchmark','analysis','protocol','formal','verification']
  const spam=['free tokens','airdrop','follow.*rt','giveaway','limited time','!!']
  const fud=['vaporware','dump','rug','scam','ngmi','fake']
  if(spam.some(t=>new RegExp(t).test(l))) return{dims:{relevance:10,technical:0,originality:5,tone:5,engagement:20},cat:'spam'}
  if(fud.filter(t=>l.includes(t)).length>=2) return{dims:{relevance:55,technical:5,originality:25,tone:8,engagement:30},cat:'fud'}
  const glHits=gl.filter(t=>l.includes(t)).length
  const techHits=tech.filter(t=>l.includes(t)).length
  const isMeme=(l.includes('😭')||l.includes('💀')||l.includes('lol')||l.includes('ngmi'))&&l.length<200
  const isShill=(l.includes('moon')||l.includes('100x')||l.includes('pump')||l.includes('buy now'))
  if(isShill) return{dims:{relevance:50,technical:10,originality:20,tone:20,engagement:60},cat:'shill'}
  if(isMeme) return{dims:{relevance:Math.min(100,50+glHits*10),technical:12,originality:65,tone:68,engagement:80},cat:'meme'}
  const isResearch=(l.includes('paper')||l.includes('proof')||l.includes('benchmark')||l.includes('analysis'))&&techHits>1
  const isCommunity=(l.includes('update')||l.includes('launch')||l.includes('milestone')||l.includes('partner'))
  const cat=isResearch?'research':isCommunity?'community':glHits>1?'educational':'community'
  return{dims:{
    relevance:Math.min(100,35+glHits*13+techHits*4+(text.length>200?8:0)),
    technical:Math.min(100,20+techHits*14+glHits*6),
    originality:Math.min(100,35+(text.length>180?18:0)+(isResearch?20:0)+(text.includes('🧵')?10:0)),
    tone:Math.min(100,65+glHits*4),
    engagement:Math.min(100,55+(text.includes('🚀')||text.includes('💡')||text.includes('🧵')?18:0)),
  },cat}
}

function getFeedback(cat,verdict,dims){
  if(verdict==='approved'){
    if(cat==='research') return 'Strong technical content with specific GenLayer references. Claims are accurate and well-supported.'
    if(cat==='educational') return 'Clear educational value for the GenLayer community. Good engagement potential for developers.'
    if(cat==='community') return 'Solid ecosystem update with relevant milestones. Professional tone and appropriate engagement.'
    return 'Content meets community standards and threshold criteria.'
  }
  if(dims.tone<20) return 'Tone quality is critically low — hostile or manipulative framing detected.'
  if(dims.technical<15) return 'No verifiable technical claims. Content lacks substance for the GenLayer ecosystem.'
  return 'Content falls below the required threshold for this profile. Improve relevance and technical accuracy.'
}

