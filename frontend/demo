function spwUpdatePreview(){
  const vals={};let sum=0
  DIMS.forEach(d=>{vals[d]=parseInt(document.getElementById('spw-'+d)?.value||0);sum+=vals[d]})
  const sumEl=document.getElementById('spw-sum')
