  document.getElementById('st-tx-hash').textContent='TX: 0x'+Math.random().toString(16).slice(2,18)+'...'
  document.getElementById('st-result').innerHTML=buildResultHTML(entry,p)
  showToast(`Evaluated · ${result.verdict.toUpperCase()} · score: ${result.score}`,result.verdict==='approved'?'green':'red')
}

