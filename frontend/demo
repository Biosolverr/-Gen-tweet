<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>GenLayer Tweet Evaluator — Demo</title>
<style>
@import url('https://fonts.googleapis.com/css2?family=Syne:wght@400;600;700;800&family=DM+Sans:wght@300;400;500;600&family=JetBrains+Mono:wght@400;500&display=swap');
*{box-sizing:border-box;margin:0;padding:0}
:root{
  --bg:#0a0a0f;--surface:#0e0e18;--card:#111118;--border:#1e1e2e;
  --accent:#7c3aed;--accent2:#a78bfa;--text:#e2e8f0;--muted:#6b7280;--muted2:#374151;
  --green:#10b981;--red:#ef4444;--amber:#f59e0b;--blue:#3b82f6;
}
html,body{background:var(--bg);color:var(--text);font-family:'DM Sans',sans-serif;min-height:100vh}
::-webkit-scrollbar{width:5px;height:5px}
::-webkit-scrollbar-track{background:#0e0e18}
::-webkit-scrollbar-thumb{background:#2a2a3a;border-radius:3px}

/* LAYOUT */
.shell{display:flex;min-height:100vh}
.sidebar{width:210px;flex-shrink:0;background:var(--surface);border-right:1px solid var(--border);display:flex;flex-direction:column;position:fixed;top:0;left:0;height:100vh;z-index:100}
.main{margin-left:210px;flex:1;min-height:100vh}

/* SIDEBAR */
.sb-head{padding:20px 16px 16px;border-bottom:1px solid var(--border)}
.sb-logo{display:flex;align-items:center;gap:9px}
.sb-hex{width:24px;height:24px;flex-shrink:0}
.sb-brand{font-family:'Syne',sans-serif;font-size:13.5px;font-weight:700;color:#c4b5fd}
.sb-tag{font-size:10px;color:var(--muted);font-family:'JetBrains Mono',monospace;margin-top:3px}
.sb-nav{flex:1;padding:10px 8px;display:flex;flex-direction:column;gap:1px}
.nav-btn{display:flex;align-items:center;gap:9px;padding:9px 10px;border-radius:8px;cursor:pointer;font-size:12.5px;color:var(--muted);border:1px solid transparent;transition:all .12s;background:none;width:100%;text-align:left}
.nav-btn:hover{background:#ffffff08;color:var(--text)}
.nav-btn.active{background:rgba(124,58,237,.15);color:var(--accent2);border-color:rgba(124,58,237,.25)}
.nav-icon{font-size:15px;width:18px;text-align:center;font-style:normal}
.nav-dot{width:5px;height:5px;border-radius:50%;background:var(--accent2);margin-left:auto;flex-shrink:0}
.sb-foot{padding:12px 16px;border-top:1px solid var(--border)}
.status-row{display:flex;align-items:center;gap:6px;font-size:11px;color:var(--muted)}
.pulse{width:7px;height:7px;border-radius:50%;background:var(--green);animation:pulse 2s infinite;flex-shrink:0}
@keyframes pulse{0%,100%{opacity:1}50%{opacity:.35}}
.sb-addr{font-size:10px;color:var(--muted2);font-family:'JetBrains Mono',monospace;margin-top:4px}

/* TOPBAR */
.topbar{padding:18px 28px 14px;border-bottom:1px solid var(--border);display:flex;align-items:flex-start;justify-content:space-between;background:var(--surface);position:sticky;top:0;z-index:50}
.page-title{font-family:'Syne',sans-serif;font-size:20px;font-weight:700;color:var(--text)}
.page-sub{font-size:12px;color:var(--muted);margin-top:3px}
.topbar-badge{display:flex;align-items:center;gap:6px;font-size:11px;color:var(--muted);background:var(--card);border:1px solid var(--border);padding:6px 12px;border-radius:8px}

/* CONTENT */
.page{display:none;padding:24px 28px;flex-direction:column;gap:18px}
.page.active{display:flex}

/* CARDS */
.card{background:var(--card);border:1px solid var(--border);border-radius:12px;padding:18px}
.card-title{font-size:11px;font-weight:600;color:var(--muted);text-transform:uppercase;letter-spacing:.07em;margin-bottom:14px}
.card-title2{font-family:'Syne',sans-serif;font-size:15px;font-weight:600;color:var(--text);margin-bottom:12px}

/* STAT GRID */
.stats-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:12px}
.stat-card{background:var(--card);border:1px solid var(--border);border-radius:12px;padding:16px}
.stat-lbl{font-size:10px;font-weight:600;color:var(--muted);text-transform:uppercase;letter-spacing:.06em}
.stat-val{font-size:26px;font-weight:700;font-family:'Syne',sans-serif;margin-top:5px;line-height:1}
.stat-sub{font-size:11px;color:var(--muted);margin-top:3px}

/* SCORE BAR */
.sbar-wrap{margin-bottom:10px}
.sbar-row{display:flex;justify-content:space-between;align-items:center;font-size:11px;margin-bottom:4px}
.sbar-lbl{color:var(--muted)}
.sbar-track{height:5px;background:var(--border);border-radius:3px;overflow:hidden}
.sbar-fill{height:100%;border-radius:3px;transition:width .5s cubic-bezier(.4,0,.2,1)}

/* BADGES */
.badge{display:inline-flex;align-items:center;gap:4px;padding:2px 8px;border-radius:5px;font-size:10.5px;font-family:'JetBrains Mono',monospace;font-weight:500;white-space:nowrap}
.badge-edu{background:#1a3a6e22;color:#60a5fa;border:1px solid #1a3a6e55}
.badge-com{background:#2e1a6e22;color:#a78bfa;border:1px solid #2e1a6e55}
.badge-res{background:#064e3b22;color:#34d399;border:1px solid #064e3b55}
.badge-meme{background:#42200622;color:#fbbf24;border:1px solid #42200655}
.badge-spam{background:#45000022;color:#f87171;border:1px solid #45000055}
.badge-fud{background:#45000022;color:#fca5a5;border:1px solid #45000055}
.badge-shill{background:#7c1f0022;color:#fb923c;border:1px solid #7c1f0055}
.badge-lbl{display:inline-block;padding:2px 7px;border-radius:4px;font-size:10px;font-weight:600}
.v-pass{background:#05280e;color:#4ade80;border:1px solid #166534}
.v-fail{background:#300505;color:#f87171;border:1px solid #7f1d1d}
.v-review{background:#3a1f00;color:#fbbf24;border:1px solid #78350f}
.conf-high{color:var(--green);font-size:10.5px;font-family:'JetBrains Mono',monospace}
.conf-med{color:var(--amber);font-size:10.5px;font-family:'JetBrains Mono',monospace}
.conf-low{color:var(--red);font-size:10.5px;font-family:'JetBrains Mono',monospace}

/* GRID 2 */
.grid2{display:grid;grid-template-columns:1fr 1fr;gap:16px}
.grid3{display:grid;grid-template-columns:1fr 1fr 1fr;gap:12px}

/* FORM */
.form-group{display:flex;flex-direction:column;gap:6px}
.form-label{font-size:10.5px;font-weight:600;color:var(--muted);text-transform:uppercase;letter-spacing:.06em}
.form-input,.form-select,.form-textarea{width:100%;background:#0b0b12;border:1px solid var(--border);border-radius:8px;padding:9px 12px;font-size:13px;color:var(--text);font-family:'DM Sans',sans-serif;outline:none;transition:border-color .15s}
.form-input:focus,.form-select:focus,.form-textarea:focus{border-color:rgba(124,58,237,.5)}
.form-textarea{resize:none;line-height:1.6}
.form-select{cursor:pointer}
.form-input::placeholder,.form-textarea::placeholder{color:var(--muted2)}
.counter{font-size:11px;font-family:'JetBrains Mono',monospace;color:var(--muted);text-align:right}

/* BUTTON */
.btn{display:inline-flex;align-items:center;justify-content:center;gap:7px;padding:9px 18px;border-radius:8px;font-size:13px;font-weight:500;cursor:pointer;font-family:'DM Sans',sans-serif;transition:all .12s;border:none}
.btn-primary{background:var(--accent);color:#fff}
.btn-primary:hover{background:#6d28d9}
.btn-primary:active{transform:scale(.98)}
.btn-secondary{background:var(--card);color:var(--text);border:1px solid var(--border)}
.btn-secondary:hover{background:#ffffff08}
.btn:disabled{opacity:.45;cursor:not-allowed;transform:none!important}
.btn-full{width:100%}

/* SPINNER */
.spinner{width:16px;height:16px;border:2px solid rgba(255,255,255,.2);border-top-color:#fff;border-radius:50%;animation:spin .7s linear infinite}
@keyframes spin{to{transform:rotate(360deg)}}

/* RESULT PANEL */
.result-panel{background:var(--card);border:1px solid var(--border);border-radius:12px;padding:18px;display:flex;flex-direction:column;gap:14px}
.result-empty{display:flex;flex-direction:column;align-items:center;justify-content:center;min-height:280px;text-align:center;gap:8px}
.result-empty-icon{font-size:32px;opacity:.2}
.big-score{font-family:'Syne',sans-serif;font-size:48px;font-weight:800;line-height:1}
.big-score-unit{font-size:20px;font-weight:400;color:var(--muted)}

/* PROFILE WEIGHT VIZ */
.weight-strip{display:flex;height:18px;border-radius:5px;overflow:hidden;gap:1px}
.weight-seg{display:flex;align-items:center;justify-content:center;font-size:8.5px;font-weight:700;color:#fff;transition:width .4s}
.profile-meta{display:grid;grid-template-columns:1fr 1fr;gap:8px;margin-top:10px}
.meta-item{background:#0b0b12;border:1px solid var(--border);border-radius:7px;padding:9px}
.meta-key{font-size:10px;color:var(--muted);margin-bottom:2px}
.meta-val{font-size:13px;font-weight:600;font-family:'JetBrains Mono',monospace}

/* TABLE */
.eval-table{width:100%;border-collapse:collapse;font-size:12px}
.eval-table th{text-align:left;font-size:10px;font-weight:600;color:var(--muted);text-transform:uppercase;letter-spacing:.06em;padding:0 10px 8px;border-bottom:1px solid var(--border)}
.eval-table td{padding:9px 10px;border-bottom:1px solid #1a1a28;vertical-align:middle}
.eval-table tr:hover td{background:#ffffff04}
.eval-table .id-cell{font-family:'JetBrains Mono',monospace;color:var(--accent2);font-size:11px}
.eval-table .score-cell{font-family:'JetBrains Mono',monospace;font-weight:600;font-size:13px}

/* DONUT */
.donut-wrap{display:flex;align-items:center;gap:16px}
.legend-item{display:flex;align-items:center;gap:7px;font-size:12px;margin-bottom:7px}
.legend-dot{width:9px;height:9px;border-radius:2px;flex-shrink:0}
.legend-lbl{color:var(--muted);flex:1}
.legend-val{font-family:'JetBrains Mono',monospace;color:var(--text)}
.legend-pct{font-family:'JetBrains Mono',monospace;color:var(--muted);width:32px;text-align:right;font-size:10.5px}

/* PROFILE TABS */
.profile-tabs{display:flex;gap:6px;margin-bottom:16px}
.profile-tab{padding:7px 16px;border-radius:8px;font-size:12.5px;font-weight:500;cursor:pointer;border:1px solid var(--border);color:var(--muted);background:var(--card);transition:all .12s}
.profile-tab:hover{color:var(--text);border-color:var(--accent2)40}
.profile-tab.active{color:var(--accent2);background:rgba(124,58,237,.12);border-color:rgba(124,58,237,.3)}

/* WEIGHT SLIDERS */
.slider-wrap{display:flex;flex-direction:column;gap:12px}
.slider-row{display:flex;align-items:center;gap:10px}
.slider-name{font-size:12px;color:var(--muted);width:130px;flex-shrink:0}
.slider-input{flex:1;-webkit-appearance:none;height:4px;background:var(--border);border-radius:2px;outline:none;cursor:pointer}
.slider-input::-webkit-slider-thumb{-webkit-appearance:none;width:14px;height:14px;border-radius:50%;background:var(--accent2);cursor:pointer}
.slider-val{font-family:'JetBrains Mono',monospace;font-size:11.5px;color:var(--text);width:28px;text-align:right;flex-shrink:0}
.sum-indicator{font-size:12px;padding:7px 12px;border-radius:7px;border:1px solid;margin-top:6px;font-family:'JetBrains Mono',monospace}
.sum-ok{color:var(--green);background:#05280e22;border-color:#166534}
.sum-bad{color:var(--red);background:#30050522;border-color:#7f1d1d}

/* BANNED TAG */
.banned-input{display:flex;flex-wrap:wrap;gap:5px;background:#0b0b12;border:1px solid var(--border);border-radius:8px;padding:7px 10px;min-height:40px;cursor:text;align-items:center}
.banned-tag{display:flex;align-items:center;gap:4px;background:rgba(239,68,68,.15);border:1px solid rgba(239,68,68,.3);color:#f87171;border-radius:4px;padding:2px 8px;font-size:11px;font-family:'JetBrains Mono',monospace}
.banned-tag button{background:none;border:none;color:#f87171;cursor:pointer;font-size:12px;padding:0;line-height:1}

/* ALERT */
.alert{padding:10px 14px;border-radius:8px;font-size:12.5px;border:1px solid}
.alert-green{background:#05280e22;border-color:#166534;color:#4ade80}
.alert-red{background:#30050522;border-color:#7f1d1d;color:#f87171}
.alert-amber{background:#3a1f0022;border-color:#78350f;color:#fbbf24}
.alert-purple{background:rgba(124,58,237,.12);border-color:rgba(124,58,237,.3);color:var(--accent2)}

/* HARD RULE */
.hard-rule-box{background:#30050522;border:1px solid #7f1d1d;border-radius:8px;padding:10px 14px}
.hard-rule-label{font-size:10px;font-weight:600;color:#f87171;text-transform:uppercase;letter-spacing:.06em;margin-bottom:3px}
.hard-rule-val{font-size:12.5px;color:#fca5a5;font-family:'JetBrains Mono',monospace}

/* PROGRESS STEP */
.progress-bar-outer{height:3px;background:var(--border);border-radius:2px;overflow:hidden;margin:8px 0}
.progress-bar-inner{height:100%;background:var(--accent);border-radius:2px;transition:width .3s}

/* TWEET SAMPLES */
.tweet-sample{background:#0b0b12;border:1px solid var(--border);border-radius:8px;padding:12px 14px;cursor:pointer;transition:border-color .12s;position:relative}
.tweet-sample:hover{border-color:rgba(124,58,237,.4)}
.tweet-sample-header{display:flex;align-items:center;gap:8px;margin-bottom:7px}
.tweet-avatar{width:28px;height:28px;border-radius:50%;display:flex;align-items:center;justify-content:center;font-size:11px;font-weight:700;color:#fff;flex-shrink:0}
.tweet-handle{font-size:11.5px;font-weight:600;color:var(--text)}
.tweet-handle span{font-weight:400;color:var(--muted);margin-left:4px}
.tweet-text{font-size:12.5px;color:var(--muted);line-height:1.6}
.tweet-select{position:absolute;top:10px;right:10px;font-size:10px;color:var(--accent2)}

/* RESPONSIVE SUBMIT LAYOUT */
.submit-layout{display:grid;grid-template-columns:1fr 340px;gap:18px;align-items:start}

/* HISTORY TABLE */
.hist-row{display:flex;align-items:center;gap:10px;padding:9px 12px;background:var(--card);border:1px solid var(--border);border-radius:8px;margin-bottom:6px;cursor:pointer;transition:border-color .12s}
.hist-row:hover{border-color:rgba(124,58,237,.3)}
.hist-url{font-size:11px;font-family:'JetBrains Mono',monospace;color:var(--muted);flex:1;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}

/* TABS BAR */
.tabs-bar{display:flex;border-bottom:1px solid var(--border);margin-bottom:16px}
.tab-item{padding:9px 16px;font-size:12.5px;color:var(--muted);cursor:pointer;border-bottom:2px solid transparent;transition:all .12s;background:none;border-top:none;border-left:none;border-right:none}
.tab-item.active{color:var(--accent2);border-bottom-color:var(--accent)}
.tab-item:hover:not(.active){color:var(--text)}

/* MINI DONUT */
svg text{font-family:'JetBrains Mono',monospace}
</style>
</head>
<body>

<div class="shell">
<!-- SIDEBAR -->
<div class="sidebar">
  <div class="sb-head">
    <div class="sb-logo">
      <svg class="sb-hex" viewBox="0 0 26 26" fill="none">
        <polygon points="13,2 24,8 24,18 13,24 2,18 2,8" fill="rgba(124,58,237,.2)" stroke="#7c3aed" stroke-width="1.5"/>
        <polygon points="13,7 20,10.5 20,15.5 13,19 6,15.5 6,10.5" fill="#7c3aed" opacity=".75"/>
      </svg>
      <span class="sb-brand">GenLayer</span>
    </div>
    <div class="sb-tag">TweetEvaluator · demo</div>
  </div>
  <nav class="sb-nav">
    <button class="nav-btn active" onclick="showPage('overview',this)"><i class="nav-icon">◈</i>Overview<span class="nav-dot"></span></button>
    <button class="nav-btn" onclick="showPage('submit',this)"><i class="nav-icon">⊕</i>Submit Tweet</button>
    <button class="nav-btn" onclick="showPage('results',this)"><i class="nav-icon">≡</i>Eval History</button>
    <button class="nav-btn" onclick="showPage('analytics',this)"><i class="nav-icon">◉</i>Analytics</button>
    <button class="nav-btn" onclick="showPage('profiles',this)"><i class="nav-icon">◫</i>Profiles</button>
  </nav>
  <div class="sb-foot">
    <div class="status-row"><span class="pulse"></span>Simulation Mode</div>
    <div class="sb-addr">demo · no contract needed</div>
  </div>
</div>

<!-- MAIN -->
<div class="main">

<!-- OVERVIEW PAGE -->
<div id="page-overview" class="page active">
  <div style="position:sticky;top:0;z-index:50;background:var(--surface);border-bottom:1px solid var(--border);padding:18px 28px 14px;display:flex;justify-content:space-between;align-items:flex-start;margin:-24px -28px 0;margin-bottom:18px">
    <div>
      <div class="page-title">Overview</div>
      <div class="page-sub">Simulation based on 84 real on-chain evaluations · 3 profiles × 4 categories</div>
    </div>
    <div class="topbar-badge"><span class="pulse"></span>Simulation Active</div>
  </div>

  <div class="stats-grid" id="overview-stats">
    <div class="stat-card"><div class="stat-lbl">Total Evaluated</div><div class="stat-val">84</div><div class="stat-sub">Across 3 profiles</div></div>
    <div class="stat-card"><div class="stat-lbl">Approved</div><div class="stat-val" style="color:var(--green)">46</div><div class="stat-sub">54.8% approval rate</div></div>
    <div class="stat-card"><div class="stat-lbl">Rejected</div><div class="stat-val" style="color:var(--red)">38</div><div class="stat-sub">By rules + threshold</div></div>
    <div class="stat-card"><div class="stat-lbl">Profiles Tested</div><div class="stat-val" style="color:var(--accent2)">3</div><div class="stat-sub">Lenient · Moderate · Strict</div></div>
  </div>

  <div class="grid2">
    <div class="card">
      <div class="card-title">Approval rate by profile</div>
      <div id="profile-bars"></div>
    </div>
    <div class="card">
      <div class="card-title">Category performance (strict profile)</div>
      <div id="cat-bars"></div>
    </div>
  </div>

  <div class="card">
    <div class="card-title">Key findings from test dataset</div>
    <div class="grid3" style="gap:12px">
      <div style="background:#0b0b12;border:1px solid var(--border);border-radius:8px;padding:14px">
        <div style="font-size:22px;margin-bottom:8px">🔬</div>
        <div style="font-size:13px;font-weight:600;color:var(--text);margin-bottom:5px">Research wins always</div>
        <div style="font-size:12px;color:var(--muted);line-height:1.6">Across all profiles, research content scored highest. Equivalence Principle, validators, Optimistic Democracy = top scores.</div>
      </div>
      <div style="background:#0b0b12;border:1px solid var(--border);border-radius:8px;padding:14px">
        <div style="font-size:22px;margin-bottom:8px">🎭</div>
        <div style="font-size:13px;font-weight:600;color:var(--text);margin-bottom:5px">Memes: biggest variance</div>
        <div style="font-size:12px;color:var(--muted);line-height:1.6">Lenient: 57% pass. Moderate: partial. Strict: 0% — all 7 memes rejected regardless of engagement score.</div>
      </div>
      <div style="background:#0b0b12;border:1px solid var(--border);border-radius:8px;padding:14px">
        <div style="font-size:22px;margin-bottom:8px">⚡</div>
        <div style="font-size:13px;font-weight:600;color:var(--text);margin-bottom:5px">Protocol terms matter</div>
        <div style="font-size:12px;color:var(--muted);line-height:1.6">Explicit mention of GenVM, Intelligent Contracts, or Optimistic Democracy consistently boosts relevance score.</div>
      </div>
    </div>
  </div>

  <div class="card">
    <div class="card-title">Real test results summary</div>
    <table class="eval-table">
      <thead><tr><th>Profile</th><th>Category</th><th>Approved</th><th>Rejected</th><th>Rate</th><th>Key Observation</th></tr></thead>
      <tbody id="summary-table"></tbody>
    </table>
  </div>
</div>

<!-- SUBMIT PAGE -->
<div id="page-submit" class="page">
  <div style="position:sticky;top:0;z-index:50;background:var(--surface);border-bottom:1px solid var(--border);padding:18px 28px 14px;display:flex;justify-content:space-between;align-items:flex-start;margin:-24px -28px 0;margin-bottom:18px">
    <div>
      <div class="page-title">Submit Tweet</div>
      <div class="page-sub">Evaluate a tweet using the configured profile weights</div>
    </div>
    <button class="btn btn-primary" onclick="showPage('profiles',document.querySelector('.nav-btn:nth-child(5)'))">⚙ Edit Profiles</button>
  </div>

  <div class="submit-layout">
    <!-- LEFT: FORM -->
    <div style="display:flex;flex-direction:column;gap:14px">
      <!-- Tweet samples -->
      <div class="card">
        <div class="card-title">Quick samples — click to load</div>
        <div style="display:flex;flex-direction:column;gap:7px" id="tweet-samples"></div>
      </div>

      <!-- Form -->
      <div class="card">
        <div class="card-title2">Tweet Details</div>
        <div style="display:flex;flex-direction:column;gap:14px">
          <div class="form-group">
            <label class="form-label">Tweet URL</label>
            <input class="form-input" id="tweet-url" placeholder="https://x.com/user/status/..." value="https://x.com/builder/status/A1">
          </div>
          <div class="form-group">
            <label class="form-label">Tweet Text</label>
            <textarea class="form-textarea" id="tweet-text" rows="5" oninput="updateCounter()" placeholder="Paste tweet content here...">Just published a deep dive into GenLayer's Equivalence Principle — showing how heterogeneous AI validators reach deterministic consensus on non-deterministic tasks. The math behind Optimistic Democracy is surprisingly elegant. Full analysis + benchmark data included. 🧵</textarea>
            <div class="counter" id="char-counter">269 chars</div>
          </div>
          <div class="form-group">
