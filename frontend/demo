// HELPERS / COMPUTE
// ════════════════════════════════════════════════════════
function computeStats(){
  const e=STATE.evaluations, t=e.length
  const approved=e.filter(x=>x.verdict==='approved').length
  const rejected=e.filter(x=>x.verdict==='rejected').length
  const nr=e.filter(x=>x.verdict==='needs_review').length
  const hr=e.filter(x=>x.hard_rule_triggered).length
  const avg=t?Math.round(e.reduce((a,x)=>a+x.total_score,0)/t):0
  return{total:t,approved,rejected,needs_review:nr,hard_rule_rejections:hr,threshold_rejections:rejected-hr,avg_total_score:avg}
}
function computeConfig(){
  return{owner:'0x9b...96e1',paused:STATE.paused,default_profile:STATE.defaultProfile,total_evaluations:STATE.evaluations.length}
}
function computeCatBreakdown(){
  const r={}; STATE.evaluations.forEach(e=>{r[e.category]=(r[e.category]||0)+1}); return r
}
function computeProfileBreakdown(){
  const r={}; STATE.evaluations.forEach(e=>{r[e.profile]=(r[e.profile]||0)+1}); return r
}
function computeHardRuleBreakdown(){
  const r={}; STATE.evaluations.forEach(e=>{const k=e.hard_rule_triggered||'none';r[k]=(r[k]||0)+1}); return r
}
function profileToJSON(p){
  return{name:p.name,threshold:p.threshold,weights:{relevance:p.weights.relevance,technical:p.weights.technical,originality:p.weights.originality,tone:p.weights.tone,engagement:p.weights.engagement},banned_categories:p.banned.join(','),min_technical:p.minTech,min_tone:p.minTone,description:p.desc,is_default:p.isDefault}
}
function evalToFull(e){
  return{eval_id:e.eval_id,url:e.url,text:e.text,submitter:e.submitter,timestamp:e.timestamp,profile:e.profile,dimensions:e.dimensions,total_score:e.total_score,verdict:e.verdict,category:e.category,confidence:e.confidence,feedback:e.feedback,hard_rule_triggered:e.hard_rule_triggered}
}
function evalToSummary(e){
  return{eval_id:e.eval_id,url:e.url,total_score:e.total_score,verdict:e.verdict,confidence:e.confidence,profile:e.profile,hard_rule:e.hard_rule_triggered}
}

function showToast(msg,type){
  const t=document.getElementById('toast')
  t.style.display='block'
  t.style.color=type==='green'?'#4ade80':type==='red'?'#f87171':'var(--t2)'
  t.textContent=msg
  clearTimeout(window.__toastTimer)
  window.__toastTimer=setTimeout(()=>t.style.display='none',2800)
}
function sleep(ms){return new Promise(r=>setTimeout(r,ms))}

