async function runEvaluation() {
  const url = document.getElementById('tweet-url').value.trim()
  const text = document.getElementById('tweet-text').value.trim()
  const profileName = document.getElementById('profile-select').value
  if(!url || !text) { showQuickAlert('URL and tweet text are required','red'); return }

  const btn = document.getElementById('eval-btn')
  const lbl = document.getElementById('eval-btn-label')
  btn.disabled = true
  lbl.innerHTML = '<span class="spinner"></span> Evaluating…'

  // Simulate async AI evaluation
  await sleep(800)

  // Find matching sample or generate scores
  const sample = TWEET_SAMPLES.find(s => s.url === url || s.text === text)
  const profile = PROFILES[profileName]

  let dims
  if(sample) {
    dims = {...sample.dims}
  } else {
    // Score based on text content heuristics
    dims = scoreTweet(text)
  }

  const cat = sample ? sample.cat : detectCategory(text)
  await sleep(600)

  // Apply profile scoring
  const result = applyProfile(dims, cat, profile)

  // Show result
  renderResult(result, dims, cat, profileName, url, text, profile)

  // Save to history
  evalHistory.unshift({
    url, text, profileName, cat, result, dims,
    time: new Date().toLocaleTimeString()
  })

  btn.disabled = false
  lbl.textContent = 'Evaluate Tweet'
}

function scoreTweet(text) {
  const lower = text.toLowerCase()
  const glTerms = ['genlayer','equivalence principle','genvm','intelligent contract','optimistic democracy','validator']
  const techTerms = ['consensus','algorithm','proof','benchmark','analysis','protocol','testnet','mainnet']
  const spamTerms = ['free tokens','airdrop','follow + rt','limited to','hurry','giveaway','winner']
  const fudTerms = ['vaporware','dump','rekt','scam','rug','ngmi','fake']
  const memeTerms = ['lol','😭','💀','ngmi','wen','ser','gm','gn','wagmi','based','chad']

  const glScore = glTerms.filter(t => lower.includes(t)).length
  const techScore = techTerms.filter(t => lower.includes(t)).length
  const isSpam = spamTerms.some(t => lower.includes(t))
  const isFud = fudTerms.filter(t => lower.includes(t)).length >= 2
  const isMeme = memeTerms.filter(t => lower.includes(t)).length >= 2

  if(isSpam) return {relevance:10,technical:0,originality:5,tone:5,engagement:20}
  if(isFud) return {relevance:60,technical:5,originality:30,tone:8,engagement:35}
  if(isMeme) return {relevance:60+glScore*5,technical:15,originality:65,tone:70,engagement:80}

  const rel = Math.min(100, 50 + glScore*12 + (text.length>150?10:0))
  const tech = Math.min(100, 30 + techScore*15 + glScore*8)
  const orig = Math.min(100, 40 + (text.length>200?20:0) + (text.includes('🧵')||text.includes('paper')||text.includes('analysis')?20:0))
  const tone = Math.min(100, 70 + glScore*3 - (isFud?50:0))
  const eng = Math.min(100, 60 + (text.includes('🚀')||text.includes('💡')||text.includes('🧵')?15:0))
  return {relevance:rel,technical:tech,originality:orig,tone,engagement:eng}
}

function detectCategory(text) {
  const lower = text.toLowerCase()
  if(['free tokens','airdrop','follow + rt','giveaway'].some(t => lower.includes(t))) return 'spam'
  if(['vaporware','scam','dump','rug'].some(t => lower.includes(t))) return 'fud'
  if(['price','moon','pump','buy now','100x'].some(t => lower.includes(t))) return 'shill'
  if(['lol','😭','💀','meme','vibes'].some(t => lower.includes(t))) return 'meme'
  if(['paper','benchmark','proof','analysis','formal','research'].some(t => lower.includes(t))) return 'research'
  if(['update','launched','milestone','partnership','ama','community'].some(t => lower.includes(t))) return 'community'
  return 'educational'
}

function applyProfile(dims, cat, profile) {
  const w = profile.weights
  const totalScore = Math.round(
    dims.relevance * w.relevance / 100 +
    dims.technical * w.technical / 100 +
    dims.originality * w.originality / 100 +
    dims.tone * w.tone / 100 +
    dims.engagement * w.engagement / 100
  )

  // Hard rules
  if(profile.banned.includes(cat)) return {verdict:'rejected',score:totalScore,hardRule:`BANNED_CATEGORY:${cat}`,confidence:cat==='spam'||cat==='fud'?'high':'medium'}
  if(dims.technical < profile.minTech) return {verdict:'rejected',score:totalScore,hardRule:`MIN_TECHNICAL:${dims.technical}<${profile.minTech}`,confidence:'high'}
  if(dims.tone < profile.minTone) return {verdict:'rejected',score:totalScore,hardRule:`MIN_TONE:${dims.tone}<${profile.minTone}`,confidence:'high'}

  const verdict = totalScore >= profile.threshold ? 'approved' : 'rejected'
  const confidence = Math.abs(totalScore - profile.threshold) < 10 ? 'medium' : 'high'
  return {verdict, score:totalScore, hardRule:'', confidence}
}

function renderResult(result, dims, cat, profileName, url, text, profile) {
  const verdictColor = result.verdict==='approved'?'var(--green)':'var(--red)'
  const scoreColor = result.score>=75?'var(--green)':result.score>=50?'var(--amber)':'var(--red)'

  const dimBars = DIMS.map(d => {
    const v = dims[d]
    const c = v>=70?'var(--green)':v>=40?'var(--amber)':'var(--red)'
    return `<div class="sbar-wrap">
      <div class="sbar-row">
        <span class="sbar-lbl">${DIM_LABELS[d]}</span>
        <div style="display:flex;gap:8px;align-items:center">
          <span style="font-size:10px;color:var(--muted)">${profile.weights[d]}% weight</span>
          <span style="font-family:'JetBrains Mono',monospace;font-size:11.5px;color:${c}">${v}</span>
        </div>
      </div>
      <div class="sbar-track"><div class="sbar-fill" style="width:${v}%;background:${c}"></div></div>
    </div>`
  }).join('')

  document.getElementById('result-area').innerHTML = `
  <div style="display:flex;flex-direction:column;gap:12px">
    <div class="result-panel" style="border-color:${result.verdict==='approved'?'rgba(16,185,129,.25)':'rgba(239,68,68,.15)'}">
      <div style="display:flex;justify-content:space-between;align-items:flex-start">
        <div>
          <span class="badge-lbl ${result.verdict==='approved'?'v-pass':'v-fail'}">${result.verdict==='approved'?'✓ APPROVED':'✗ REJECTED'}</span>
          <div class="big-score" style="color:${scoreColor};margin-top:8px">${result.score}<span class="big-score-unit">/100</span></div>
          <div style="font-size:11px;color:var(--muted);margin-top:2px">threshold: ${profile.threshold} · profile: ${profileName}</div>
        </div>
        <div style="display:flex;flex-direction:column;align-items:flex-end;gap:6px">
          <span class="badge ${getCatBadge(cat)}">${cat}</span>
          <span class="${result.confidence==='high'?'conf-high':result.confidence==='medium'?'conf-med':'conf-low'}">▲ ${result.confidence} confidence</span>
        </div>
      </div>
      ${result.hardRule ? `<div class="hard-rule-box"><div class="hard-rule-label">Hard Rule Triggered</div><div class="hard-rule-val">${result.hardRule}</div></div>` : ''}
      <div>${dimBars}</div>
    </div>
    <div class="card" style="padding:14px">
      <div class="card-title">How profile affected this score</div>
      <div style="font-size:12px;color:var(--muted);line-height:1.7">
        ${getProfileExplanation(result, dims, cat, profileName, profile)}
      </div>
    </div>
  </div>`
}

function getProfileExplanation(result, dims, cat, profileName, profile) {
  const lines = []
  if(result.hardRule) {
    if(result.hardRule.startsWith('BANNED')) lines.push(`<span style="color:var(--red)">★</span> <b>${cat}</b> is banned in ${profileName} profile — auto-rejected regardless of score.`)
    else if(result.hardRule.includes('TECHNICAL')) lines.push(`<span style="color:var(--red)">★</span> Technical score (${dims.technical}) below minimum floor (${profile.minTech}) — auto-rejected.`)
    else if(result.hardRule.includes('TONE')) lines.push(`<span style="color:var(--red)">★</span> Tone score (${dims.tone}) below minimum floor (${profile.minTone}) — auto-rejected.`)
  } else {
    if(profileName==='strict') {
      if(dims.relevance < 75) lines.push(`<span style="color:var(--amber)">▲</span> Strict profile weights Relevance at 25% — your relevance (${dims.relevance}) dragged the score down.`)
      else lines.push(`<span style="color:var(--green)">▲</span> High relevance (${dims.relevance}) is rewarded heavily at 25% weight in strict mode.`)
      lines.push(`<span style="color:var(--muted)">→</span> Engagement carries only 5% weight — viral ≠ quality under strict.`)
    } else if(profileName==='lenient') {
      lines.push(`<span style="color:var(--green)">▲</span> Engagement carries 25% weight in lenient mode — community content gets a boost.`)
      lines.push(`<span style="color:var(--muted)">→</span> Only spam is banned — FUD and memes are evaluated on score alone.`)
    } else {
      lines.push(`<span style="color:var(--muted)">→</span> Moderate profile balances all dimensions equally (20–25% each).`)
      lines.push(`<span style="color:var(--muted)">→</span> Tone (${dims.tone}) carries 25% weight — professional framing matters.`)
    }
    if(result.verdict==='approved') lines.push(`<span style="color:var(--green)">✓</span> Score ${result.score} ≥ threshold ${profile.threshold} → approved.`)
    else lines.push(`<span style="color:var(--red)">✗</span> Score ${result.score} < threshold ${profile.threshold} → rejected.`)
  }
  return lines.join('<br>')
}

// ─── HISTORY ────────────────────────────────────────────────────────────────
function renderHistory(filter) {
  const list = document.getElementById('hist-list')
  const empty = document.getElementById('hist-empty')
  const filtered = filter==='all' ? evalHistory : evalHistory.filter(e => e.result.verdict===filter)

  if(filtered.length===0 && evalHistory.length===0) {
    list.innerHTML=''; empty.style.display='flex'; return
  }
  empty.style.display = 'none'
  list.innerHTML = filtered.map((e,i) => {
    const vc = e.result.verdict==='approved'?'#4ade80':'#f87171'
    return `<div class="hist-row" onclick="showHistDetail(${i})">
      <div style="flex:1;min-width:0">
        <div style="display:flex;gap:6px;align-items:center;margin-bottom:3px">
          <span class="badge ${getCatBadge(e.cat)}">${e.cat}</span>
          <span style="font-size:10px;color:var(--muted);font-family:monospace">${e.profileName}</span>
          <span style="font-size:10px;color:var(--muted2)">${e.time}</span>
        </div>
        <div class="hist-url">${e.url}</div>
      </div>
      <span class="badge-lbl ${e.result.verdict==='approved'?'v-pass':'v-fail'}" style="font-size:10.5px">${e.result.verdict}</span>
      <span style="font-family:'JetBrains Mono',monospace;font-weight:600;color:${vc};font-size:14px;width:30px;text-align:right">${e.result.score}</span>
    </div>`
  }).join('')
  if(filtered.length===0) list.innerHTML='<div style="text-align:center;color:var(--muted);padding:30px;font-size:13px">No results for this filter</div>'
}

function filterHistory(filter, btn) {
  document.querySelectorAll('#hist-tabs .tab-item').forEach(t => t.classList.remove('active'))
  btn.classList.add('active')
  renderHistory(filter)
}

function showHistDetail(i) {
  const e = evalHistory[i]
  const profile = PROFILES[e.profileName]
  renderResult(e.result, e.dims, e.cat, e.profileName, e.url, e.text, profile)
  showPage('submit', document.querySelector('.nav-btn:nth-child(2)'))
}

